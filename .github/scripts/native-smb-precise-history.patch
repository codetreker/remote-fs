+func (f *clientFile) ValidateDiagnosticNotification(ctx context.Context, location storage.EntryLocation) error {
+	if err := f.require(windowsReadData); err != nil {
+		return err
+	}
+	if err := f.authorize(ctx, storage.OpFileListAt, 0); err != nil {
+		return err
+	}
+	if err := f.Sync(ctx); err != nil {
+		return err
+	}
+	err := f.session.validateDiagnosticDisclosure(ctx, location)
+	if err == nil {
+		return nil
+	}
+	var cleanup *clientCleanupError
+	if errors.As(err, &cleanup) || errors.Is(err, syscall.EIO) {
+		return errors.Join(syscall.EIO, err)
+	}
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if errors.Is(err, authz.ErrDenied) {
+		return err
+	}
+	switch storage.ErrnoOf(err) {
+	case syscall.EAGAIN, syscall.ESTALE, syscall.ENOENT, syscall.EEXIST, syscall.EINVAL, syscall.ENAMETOOLONG, syscall.EFBIG:
+		return errors.Join(ErrNotifyRescan, err)
+	default:
+		return err
+	}
+}
+
+func (s *clientSession) validateDiagnosticDisclosure(ctx context.Context, location storage.EntryLocation) error {
+	if err := location.Check(); err != nil {
+		return err
+	}
+	if location.RootNodeID != s.state.RootID {
+		return syscall.EIO
+	}
+	if location.State != storage.LocationLinked {
+		return syscall.ESTALE
+	}
+	prefix := storage.EntryLocation{State: storage.LocationRoot, RootNodeID: location.RootNodeID, NodeID: location.RootNodeID}
+	for i, edge := range location.Ancestors {
+		if _, err := nameKey(edge.Name); err != nil {
+			return err
+		}
+		if edge.ParentID != prefix.NodeID {
+			return syscall.ESTALE
+		}
+		id, err := s.next(ctx)
+		if err != nil {
+			return err
+		}
+		if err = s.authorize(ctx, storage.OpFileRetain, fileEffects(storage.OpFileRetain), storage.AccessClaim{}, 0, edge.ParentID, 0, 0); err != nil {
+			return err
+		}
+		receipt, err := s.raw.Retain(ctx, storage.RetainRequest{NodeID: edge.ParentID, Witness: &prefix}, id)
+		if err != nil {
+			return s.retentionFailure(ctx, receipt, err)
+		}
+		parent, err := s.raw.Reference(ctx, receipt.Reference)
+		if err != nil {
+			return s.cleanupOwnership(ctx, err)
+		}
+		if parent == nil || parent.Reference() != receipt.Reference || parent.NodeID() != edge.ParentID {
+			return s.cleanupOwnership(ctx, syscall.EIO)
+		}
+		// Historical leaf ownership comes only from the opaque proof. Every live
+		// ancestor and its complete current sibling set still controls disclosure.
+		var view directoryView
+		var viewErr error
+		if receipt.Observation.Location == nil || !sameEntryChain(prefix, *receipt.Observation.Location) {
+			viewErr = syscall.ESTALE
+		} else {
+			view, viewErr = s.directory(ctx, parent, receipt.Observation.Attr.DirectoryRevision)
+		}
+		next := edge
+		if viewErr == nil && i < len(location.Ancestors)-1 {
+			key, _ := nameKey(edge.Name)
+			at, ok := view.index[key]
+			if !ok || view.entries[at].EntryID != edge.EntryID || view.entries[at].Attr.ID != edge.NodeID {
+				viewErr = syscall.ESTALE
+			} else {
+				next.DirectoryRevision = view.revision
+			}
+		}
+		if viewErr == nil {
+			_, viewErr = parent.CheckObservation(ctx, storage.ObservationCondition{MetadataRevision: receipt.Observation.Attr.MetadataRevision, DirectoryRevision: view.revision, Location: *receipt.Observation.Location})
+		}
+		if closeErr := s.closeTemporary(ctx, parent); closeErr != nil {
+			return errors.Join(viewErr, closeErr)
+		}
+		if viewErr != nil {
+			return viewErr
+		}
+		prefix.State = storage.LocationLinked
+		prefix.NodeID = edge.NodeID
+		prefix.Ancestors = append(prefix.Ancestors, next)
+	}
+	return nil
+}
