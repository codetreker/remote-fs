{
  "name": "remote-fs-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/assets.mjs write",
    "test": "vitest run",
    "check:dist": "node scripts/assets.mjs check",
    "format:check": "prettier --check src scripts vite.config.ts tsconfig.json package.json index.html"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "0.545.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4",
    "prettier": "3.9.10"
  },
  "packageManager": "pnpm@10.34.5"
}
